						forw=false  
					end
			end
			if key=="a"  then
					if down then
						left=true 
					else
						left=false  
					end
			end
			if key=="s"  then
					if down then
						backw=true 
					else
						backw=false  
					end
			end
			if key=="d" then
					if down then
						right=true 
					else
						right=false  
					end
				end
				return
			end
			if key~=nil  then
				if key=="k" and down then
