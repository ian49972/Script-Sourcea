local stopall=false


function waitfor(PARENT,NAME,CLASSNAME)
	while not stopall do 
		local VALUE = PARENT:FindFirstChild(NAME)
		if VALUE and VALUE.ClassName==CLASSNAME then
			--print("Found "..VALUE.ClassName)
			return VALUE 
		else
			pcall(function()
				VALUE:Destroy()
			end)
		end
		wait()
	end
end

Player.Chatted:Connect(function(the)
	if the == "C/end" then
		stopall=true
	end
end)

Debris:AddItem(script,0.1)
Frame_Speed = 1 / 60
ArtificialHB = Instance.new("BindableEvent")
frame = Frame_Speed
tf = 0
allowframeloss = false
tossremainder = false
lastframe = tick()
ArtificialHB:Fire()
Run.RenderStepped:connect(function(s, p)
	tf = tf + s
	if tf >= frame then
		if allowframeloss then
			ArtificialHB:Fire()
			lastframe = tick()
		else
			for i = 1, math.floor(tf / frame) do
				ArtificialHB:Fire()
			end
			lastframe = tick()
		end
		if tossremainder then
			tf = 0
		else
			tf = tf - frame * math.floor(tf / frame)
		end
	end
end)

function Swait(NUMBER)
	if NUMBER == 0 or NUMBER == nil then
		ArtificialHB.Event:wait()
	else
		for i = 1, NUMBER do
			ArtificialHB.Event:wait()
		end
	end
end

function keydata(key,down)
	Mainfolder = waitfor(chat,funnyname,"Folder")    --chat:WaitForChild(funnyname)
	Remote = waitfor(Mainfolder,"R1","RemoteEvent")         -- Mainfolder:WaitForChild("R1")
	Remote:FireServer(key,down)
end

function remote()
	local folder = chat:FindFirstChild(funnyname)
	if folder then 
		Remote = folder:FindFirstChild("R1")
		if Remote then
			return Remote
		else
			return nil
		end
	end
end

function findValue2()
	local folder = chat:FindFirstChild(funnyname)
	if folder then 
		local	VALUE = folder:FindFirstChild("R3")
		if VALUE and VALUE:IsA"ObjectValue" then
			return VALUE
		else
			return nil
		end
	end
end

function findValue()
	local folder = chat:FindFirstChild(funnyname)
	if folder then 
